# Supabase client configuration.
# Optional — if unset, the app falls back to the bundled project so existing
# deploys keep working. Set these to point a build at a different project
# (e.g. a staging instance). The anon key is a public, RLS-gated client key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
